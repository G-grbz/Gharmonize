{
  "name": "Gharmonize",
  "desktopName": "gharmonize.desktop",
  "version": "2.0.0",
  "description": "Gharmonize is a desktop application that brings together third-party tools from various platforms to help you build and manage your local music library.",
  "author": "G-grbz <gkhn.gurbuz@hotmail.com>",
  "homepage": "https://github.com/G-grbz/Gharmonize",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "start": "electron .",
    "server": "node app.js",
    "dev": "node --watch app.js",
    "desktop:dev": "wait-on tcp:127.0.0.1:5174 && electron . --external-server",
    "desktop:build:nsis": "electron-builder --win nsis --x64 --publish never",
    "download:binaries": "node scripts/download-binaries.mjs",
    "desktop:build:appimage": "electron-builder --linux AppImage --x64 --publish never",
    "desktop:build:deb": "electron-builder --linux deb --x64 --publish never",
    "desktop:build:rpm": "electron-builder --linux rpm --x64 --publish never",
    "desktop:build:arch": "electron-builder --linux pacman --x64 --publish never",
    "desktop:build:linux": "electron-builder --linux AppImage deb rpm pacman --x64 --publish never",
    "desktop:build:portable": "electron-builder --win portable --x64 --publish never",
    "desktop:build:all": "npm run desktop:build:nsis && npm run desktop:build:portable",
    "postinstall": "node ./scripts/postinstall.cjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "check:version": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "multer": "^2.4.0",
    "music-metadata": "^12.3.4",
    "node-fetch": "^3.3.2",
    "node-id3": "^0.2.9",
    "spotify-web-api-node": "^5.0.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.1",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "lodash": "4.18.1",
    "@electron/get": "5.1.0",
    "@electron/universal": "^3.0.6",
    "minimatch": "^11.0.3",
    "@electron/asar": {
      ".": "^4.3.1",
      "glob@^13.0.2": "^14.0.3"
    },
    "temp@0.9.4": {
      "rimraf@~2.6.2": "file:../../vendor/temp-cleanup"
    }
  },
  "build": {
    "appId": "com.gharmonize.app",
    "productName": "Gharmonize",
    "executableName": "gharmonize",
    "icon": "build/icon.ico",
    "asar": true,
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "bootstrap.mjs",
      "electron/**",
      "app.js",
      "routes/**",
      "modules/**",
      "public/**",
      ".env.default",
      "config.js",
      "package.json",
      "LICENSE.md",
      "THIRD_PARTY_LICENSES.md",
      "docs/LICENSE.md",
      "docs/THIRD_PARTY_LICENSES.md",
      "cookies/**",
      "uploads/**",
      "outputs/**",
      "temp/**",
      "build/**",
      "!build/bin/**"
    ],
    "extraResources": [
      {
        "from": "build/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "LICENSE.md",
        "to": "LICENSE.md"
      },
      {
        "from": "THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      },
      {
        "from": "build/licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Gharmonize Setup ${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "G-grbz <gkhn.gurbuz@hotmail.com>",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Gharmonize",
          "StartupWMClass": "gharmonize"
        }
      }
    },
    "deb": {
      "packageName": "gharmonize",
      "artifactName": "Gharmonize-${version}-${arch}.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1",
        "libcups2 | libcups2t64",
        "libayatana-appindicator3-1 | libappindicator3-1"
      ],
      "recommends": []
    },
    "rpm": {
      "packageName": "gharmonize",
      "artifactName": "Gharmonize-${version}-${arch}.${ext}",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "libsecret",
        "alsa-lib",
        "mesa-libgbm",
        "cups-libs",
        "(libayatana-appindicator-gtk3 or libappindicator-gtk3)"
      ]
    },
    "pacman": {
      "packageName": "gharmonize",
      "artifactName": "Gharmonize-${version}-${arch}.pkg.tar.zst",
      "compression": "zstd",
      "fpm": [
        "--description=Media downloading, conversion, ripping and tagging with Gharmonize"
      ],
      "depends": [
        "alsa-lib",
        "at-spi2-core",
        "gtk3",
        "libnotify",
        "libappindicator",
        "libcups",
        "libdrm",
        "libsecret",
        "libxkbcommon",
        "libxrandr",
        "libxss",
        "mesa",
        "nss",
        "xdg-utils"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
