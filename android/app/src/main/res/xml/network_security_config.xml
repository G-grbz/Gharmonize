<?xml version="1.0" encoding="utf-8"?>
<!-- The home server is reached over the home network or Tailscale (WireGuard
     encrypted) at plain http:// addresses the user pairs with. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
